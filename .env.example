# Supabase Configuration (required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Notification Configuration (optional - for email notifications)
# These are used only in Supabase Edge Functions (server-side), never in frontend code
# RESEND_API_KEY=re_xxxxxxxxxxxx
# NOTIFICATION_FROM_EMAIL=orders@yourdomain.com
# ADMIN_EMAIL=admin@yourdomain.com

# App Configuration
VITE_APP_NAME=Lotosphere
VITE_APP_URL=http://localhost:5173
